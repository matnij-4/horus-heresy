    <selectionEntry id="0991-8bab-4d47-467a-ba420338e5c4f46a" name="Kataphron Breacherplate" publicationId="b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c" hidden="false" collective="false" import="true" type="upgrade">
