      <profiles>
        <profile id="7eda-36d0-7017-439e-886f52ea1412bbfe" name="Allarus Terminator Armor" publicationId="f7a2-b8c3-9d4e-5f60-1a2b3c4d5e6f" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
