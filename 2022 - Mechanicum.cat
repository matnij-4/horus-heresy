    <selectionEntry id="ing-wpn-icarus1" name="Icarus Array" publicationId="b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="ing-wpn-icarus1-wargear" name="Icarus Array" publicationId="b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">When a model with an Icarus Array makes a Shooting attack with it, it must first declare if it will activate its Sky-Targeting Systems. If it does, all profiles of the array gain the Skyfire Special Rule. If they do not, all weapons in the array are fired with a -2 penalty to the firing model&apos;s Ballistic Skill. All profiles of the array are fired as part of any shooting attack the firing model makes using it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink id="ing-wpn-icarus1-dae-el" name="Icarus Array - Daedalus Missile Pod" hidden="false" collective="false" import="true" targetId="efa2-a9d4-1f72-48db-9ed833057881edf4" type="selectionEntry">
