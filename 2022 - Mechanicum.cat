            <condition type="atLeast" value="1" field="selections" scope="ing-cynis-unit-0001" childId="cc2a-46fe-bbf3-6ba2" shared="true" includeChildSelections="true"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="ing-cynis-unit-0001-thanatar-maniple" name="Thanatar Maniple" publicationId="b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c" hidden="false">
          <description>When deployed onto the battlefield (either at the start of the battle or when arriving from Reserves) all models in the unit must be placed within unit coherency, but afterwards operate independently and are not treated as a single unit.

Once a unit with this Special Rule has separated, each model counts as its own unit for the purposes of Victory Points, Units Destroyed, and similar rules.</description>
        </rule>
      </rules>
