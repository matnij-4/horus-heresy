      <categoryLinks>
        <categoryLink id="29da-d839-47a5-4f3c-a4c0938e2d0a0901" name="Automata Unit Type" hidden="false" targetId="d8ab-8e21-e193-63ba" primary="false"/>
        <categoryLink id="c0ed-2497-293c-4f80-8515e3c6393c4d50" name="Cybernetica Sub-type" hidden="false" targetId="2440-b64e-cb24-87f0" primary="false"/>
        <categoryLink id="b29e-67ef-2d4b-48a5-b9f90d9d48dc6e3e" name="Heavy Sub-type" hidden="false" targetId="9231-183c-b97b-63f9" primary="false"/>
      </categoryLinks>
