            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="58c2-bb18-c08f-f2ab" type="max"/>
          </constraints>
          <profiles>
            <profile id="fe64-47e9-122e-5bb0" name="Twin-linked Maxima Bolter" publicationId="bde1-6db1-163b-3b76" page="114" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
